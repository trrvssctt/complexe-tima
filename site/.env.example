# Base PostgreSQL (docker compose : pnpm db:up)
DATABASE_URL=postgres://tima:tima@localhost:5433/complexe_tima

# Clé secrète de la page de connexion à l'espace boutique : https://…/acces/<clé>
# 16 caractères minimum. Ne la publiez nulle part. Exemple : openssl rand -hex 16
ADMIN_LOGIN_KEY=

# Clé de signature des cookies de session (32 caractères minimum) : openssl rand -base64 48
SESSION_SECRET=
